@@ -0,0 +1,14 @@
+export interface DiffStat {
+  additions: number;
+  deletions: number;
+}
+
+export function sumDiffStats(stats: ReadonlyArray<DiffStat>): DiffStat {
+  return stats.reduce(
+    (total, stat) => ({
+      additions: total.additions + stat.additions,
+      deletions: total.deletions + stat.deletions,
+    }),
+    { additions: 0, deletions: 0 },
+  );
+}
